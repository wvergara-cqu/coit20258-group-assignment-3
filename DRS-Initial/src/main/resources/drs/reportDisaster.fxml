<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="drs.controller.ReportDisasterController"
            prefHeight="680.0" prefWidth="1000.0">
    <children>
        <VBox spacing="12.0"
              AnchorPane.topAnchor="15.0" AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="20.0"  AnchorPane.rightAnchor="20.0">

            <!-- Screen heading -->
            <Label text="Report a Disaster"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>

            <!-- Input form -->
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="140.0" prefWidth="140.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Row 0: Disaster Type -->
                <Label text="Disaster Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="typeComboBox" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Row 1: Severity -->
                <Label text="Severity:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="severityComboBox" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Row 2: Location -->
                <Label text="Location:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <TextField fx:id="locationField" promptText="e.g. 12 Main St, Brisbane"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Row 3: Reporter Name -->
                <Label text="Reporter Name:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <TextField fx:id="reporterNameField" promptText="Your full name"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Row 4: Reporter Phone -->
                <Label text="Reporter Phone:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <TextField fx:id="reporterPhoneField" promptText="e.g. 0400-000-000"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Row 5: Description -->
                <Label text="Description:" GridPane.rowIndex="5" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" GridPane.valignment="TOP"/>
                <TextArea fx:id="descriptionArea"
                          promptText="Describe the disaster in detail..."
                          prefHeight="90.0" wrapText="true"
                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Action buttons -->
            <HBox spacing="10.0">
                <Button text="Submit Report" onAction="#handleSubmit"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 8 20 8 20;"/>
                <Button text="Clear" onAction="#handleClear"
                        style="-fx-padding: 8 20 8 20;"/>
            </HBox>

            <!-- Feedback label -->
            <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-font-size: 13px;"/>

            <Separator/>

            <!-- Recent reports section heading -->
            <Label text="Recently Submitted Reports (sorted by priority, highest first)"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <!-- Recent reports table -->
            <TableView fx:id="recentReportsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol"        text="ID"        prefWidth="50.0"/>
                    <TableColumn fx:id="typeCol"      text="Type"      prefWidth="110.0"/>
                    <TableColumn fx:id="severityCol"  text="Severity"  prefWidth="90.0"/>
                    <TableColumn fx:id="locationCol"  text="Location"  prefWidth="200.0"/>
                    <TableColumn fx:id="priorityCol"  text="Priority"  prefWidth="75.0"/>
                    <TableColumn fx:id="statusCol"    text="Status"    prefWidth="100.0"/>
                    <TableColumn fx:id="timestampCol" text="Submitted" prefWidth="140.0"/>
                </columns>
                <placeholder>
                    <Label text="No reports submitted yet."/>
                </placeholder>
            </TableView>

            <padding><Insets top="5.0" bottom="5.0" left="0.0" right="0.0"/></padding>
        </VBox>
    </children>
</AnchorPane>
