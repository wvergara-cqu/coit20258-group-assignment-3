<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="drs.controller.AssessDisasterController"
            prefHeight="680.0" prefWidth="1000.0">
    <children>
        <VBox spacing="10.0"
              AnchorPane.topAnchor="15.0" AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="20.0"  AnchorPane.rightAnchor="20.0">

            <!-- Screen heading -->
            <Label text="Assess and Prioritise Disaster Reports"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>

            <!-- All-reports table (upper portion) -->
            <Label text="All Reports — sorted by priority (highest first):"
                   style="-fx-font-weight: bold;"/>
            <TableView fx:id="reportsTable" prefHeight="250.0" VBox.vgrow="SOMETIMES">
                <columns>
                    <TableColumn fx:id="idCol"        text="ID"        prefWidth="50.0"/>
                    <TableColumn fx:id="typeCol"      text="Type"      prefWidth="110.0"/>
                    <TableColumn fx:id="severityCol"  text="Severity"  prefWidth="90.0"/>
                    <TableColumn fx:id="locationCol"  text="Location"  prefWidth="160.0"/>
                    <TableColumn fx:id="priorityCol"  text="Priority"  prefWidth="70.0"/>
                    <TableColumn fx:id="statusCol"    text="Status"    prefWidth="100.0"/>
                    <TableColumn fx:id="reporterCol"  text="Reporter"  prefWidth="140.0"/>
                    <TableColumn fx:id="timestampCol" text="Submitted" prefWidth="130.0"/>
                </columns>
                <placeholder>
                    <Label text="No disaster reports found. Submit one from the 'Report Disaster' tab."/>
                </placeholder>
            </TableView>

            <Separator/>

            <!-- Detail panel for the selected report -->
            <Label text="Selected Report — Details"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <GridPane hgap="12.0" vgap="6.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="110.0" prefWidth="110.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="110.0" prefWidth="110.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Row 0 -->
                <Label text="Report ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="detailIdLabel" text="-"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="detailTypeLabel" text="-"
                       GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <!-- Row 1 -->
                <Label text="Severity:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="detailSeverityLabel" text="-"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Location:" GridPane.rowIndex="1" GridPane.columnIndex="2"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="detailLocationLabel" text="-"
                       GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <!-- Row 2 -->
                <Label text="Reporter:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="detailReporterLabel" text="-" wrapText="true"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"
                       GridPane.columnSpan="3"/>

                <!-- Row 3 -->
                <Label text="Description:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" GridPane.valignment="TOP"/>
                <Label fx:id="detailDescLabel" text="-" wrapText="true"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"
                       GridPane.columnSpan="3"/>
            </GridPane>

            <!-- Priority override row -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Override Priority:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="priorityOverrideField" prefWidth="80.0"
                           promptText="1-100"/>
                <Button fx:id="overridePriorityBtn" text="Apply Override"
                        onAction="#handleOverridePriority"
                        style="-fx-padding: 5 15 5 15;"/>
            </HBox>

            <!-- Status change buttons -->
            <HBox spacing="10.0">
                <Button fx:id="startAssessmentBtn" text="Start Assessment"
                        onAction="#handleStartAssessment"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white;
                               -fx-padding: 8 15 8 15;"/>
                <Button fx:id="dispatchResponseBtn" text="Dispatch Response"
                        onAction="#handleDispatchResponse"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-padding: 8 15 8 15;"/>
                <Button fx:id="markResolvedBtn" text="Mark Resolved"
                        onAction="#handleMarkResolved"
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white;
                               -fx-padding: 8 15 8 15;"/>
            </HBox>

            <!-- Feedback label -->
            <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-font-size: 13px;"/>

            <padding><Insets top="5.0" bottom="5.0" left="0.0" right="0.0"/></padding>
        </VBox>
    </children>
</AnchorPane>
