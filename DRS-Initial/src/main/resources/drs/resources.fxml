<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="drs.controller.ResourceController"
            prefHeight="680.0" prefWidth="1000.0">
    <children>
        <VBox spacing="10.0"
              AnchorPane.topAnchor="15.0" AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="20.0"  AnchorPane.rightAnchor="20.0">

            <!-- Screen heading -->
            <Label text="Department and Responder Resource Tracker"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Creative Feature 2 — Monitor and toggle availability of all DRS resources"
                   style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

            <!-- Stats bar -->
            <HBox spacing="30.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: #ecf0f1; -fx-padding: 10; -fx-background-radius: 5;">
                <VBox>
                    <Label text="DEPARTMENTS" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <HBox spacing="20.0">
                        <Label fx:id="deptAvailableLabel" text="Available: 0"
                               style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                        <Label fx:id="deptDeployedLabel" text="Deployed: 0"
                               style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
                <Separator orientation="VERTICAL"/>
                <VBox>
                    <Label text="RESPONDERS" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <HBox spacing="20.0">
                        <Label fx:id="respAvailableLabel" text="Available: 0"
                               style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                        <Label fx:id="respDeployedLabel" text="Deployed: 0"
                               style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Two-column layout: Departments (left) | Responders (right) -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                <!-- Left: Departments -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Departments" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <TableView fx:id="deptTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="deptIdCol"      text="ID"      prefWidth="40.0"/>
                            <TableColumn fx:id="deptNameCol"    text="Name"    prefWidth="150.0"/>
                            <TableColumn fx:id="deptTypeCol"    text="Type"    prefWidth="105.0"/>
                            <TableColumn fx:id="deptContactCol" text="Contact" prefWidth="120.0"/>
                            <TableColumn fx:id="deptPhoneCol"   text="Phone"   prefWidth="95.0"/>
                            <TableColumn fx:id="deptStatusCol"  text="Status"  prefWidth="90.0"/>
                        </columns>
                        <placeholder>
                            <Label text="No departments loaded."/>
                        </placeholder>
                    </TableView>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Button fx:id="toggleDeptBtn" text="Toggle Availability"
                                onAction="#handleToggleDepartment"
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                       -fx-padding: 6 15 6 15;"/>
                        <Label fx:id="deptStatusLabel" text=""
                               style="-fx-font-size: 12px;"/>
                    </HBox>
                </VBox>

                <!-- Right: Responders -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Responders" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <TableView fx:id="respTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="respIdCol"     text="ID"         prefWidth="40.0"/>
                            <TableColumn fx:id="respNameCol"   text="Name"       prefWidth="150.0"/>
                            <TableColumn fx:id="respRoleCol"   text="Role"       prefWidth="130.0"/>
                            <TableColumn fx:id="respDeptCol"   text="Department" prefWidth="150.0"/>
                            <TableColumn fx:id="respPhoneCol"  text="Phone"      prefWidth="110.0"/>
                            <TableColumn fx:id="respStatusCol" text="Status"     prefWidth="90.0"/>
                        </columns>
                        <placeholder>
                            <Label text="No responders loaded."/>
                        </placeholder>
                    </TableView>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Button fx:id="toggleRespBtn" text="Toggle Availability"
                                onAction="#handleToggleResponder"
                                style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                       -fx-padding: 6 15 6 15;"/>
                        <Label fx:id="respStatusLabel" text=""
                               style="-fx-font-size: 12px;"/>
                    </HBox>
                </VBox>
            </HBox>

            <padding><Insets top="5.0" bottom="5.0" left="0.0" right="0.0"/></padding>
        </VBox>
    </children>
</AnchorPane>
