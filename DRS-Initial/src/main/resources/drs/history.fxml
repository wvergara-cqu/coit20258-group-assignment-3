<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="drs.controller.HistoryController"
            prefHeight="680.0" prefWidth="1000.0">
    <children>
        <VBox spacing="10.0"
              AnchorPane.topAnchor="15.0" AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="20.0"  AnchorPane.rightAnchor="20.0">

            <!-- Screen heading -->
            <Label text="Disaster History Log"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16a085;"/>
            <Label text="Creative Feature 1 — Filterable log of all disaster reports"
                   style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>

            <!-- Filter bar -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Filter by Type:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="typeFilterComboBox" prefWidth="150.0"/>

                <Label text="Filter by Status:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="statusFilterComboBox" prefWidth="150.0"/>

                <Button text="Apply Filter"  onAction="#handleApplyFilter"
                        style="-fx-background-color: #16a085; -fx-text-fill: white;
                               -fx-padding: 6 15 6 15;"/>
                <Button text="Clear Filters" onAction="#handleClearFilters"
                        style="-fx-padding: 6 15 6 15;"/>

                <Label fx:id="countLabel" text="Showing 0 record(s)"
                       style="-fx-font-style: italic; -fx-text-fill: #555555;"/>
            </HBox>

            <!-- Table + side detail panel -->
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">

                <!-- History table -->
                <TableView fx:id="historyTable" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCol"        text="ID"        prefWidth="45.0"/>
                        <TableColumn fx:id="typeCol"      text="Type"      prefWidth="100.0"/>
                        <TableColumn fx:id="severityCol"  text="Severity"  prefWidth="80.0"/>
                        <TableColumn fx:id="locationCol"  text="Location"  prefWidth="160.0"/>
                        <TableColumn fx:id="priorityCol"  text="Priority"  prefWidth="65.0"/>
                        <TableColumn fx:id="statusCol"    text="Status"    prefWidth="95.0"/>
                        <TableColumn fx:id="reporterCol"  text="Reporter"  prefWidth="120.0"/>
                        <TableColumn fx:id="timestampCol" text="Submitted" prefWidth="120.0"/>
                    </columns>
                    <placeholder>
                        <Label text="No records found. Try adjusting the filters or submit a report first."/>
                    </placeholder>
                </TableView>

                <!-- Detail side panel wrapped in ScrollPane -->
                <ScrollPane prefWidth="300.0" minWidth="280.0" fitToWidth="true"
                            style="-fx-border-color: #bdc3c7; -fx-background-color: #f4f6f7;"
                            HBox.hgrow="NEVER">
                <VBox fx:id="detailPanel" spacing="8.0"
                      style="-fx-background-color: #f4f6f7; -fx-padding: 12;">

                    <Label text="Report Details"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #16a085;"/>
                    <Separator/>

                    <!-- Placeholder shown when nothing is selected -->
                    <Label fx:id="detailPlaceholder" text="Click a row to view full details."
                           wrapText="true"
                           style="-fx-text-fill: #95a5a6; -fx-font-style: italic;"/>

                    <!-- Report fields (hidden until a row is selected) -->
                    <GridPane fx:id="detailGrid" hgap="8.0" vgap="6.0" visible="false" managed="false">
                        <Label text="ID:"           GridPane.rowIndex="0"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailId"     GridPane.rowIndex="0"  GridPane.columnIndex="1"/>

                        <Label text="Type:"         GridPane.rowIndex="1"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailType"   GridPane.rowIndex="1"  GridPane.columnIndex="1"/>

                        <Label text="Severity:"     GridPane.rowIndex="2"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailSeverity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Status:"       GridPane.rowIndex="3"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailStatus" GridPane.rowIndex="3"  GridPane.columnIndex="1"/>

                        <Label text="Priority:"     GridPane.rowIndex="4"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailPriority" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Location:"     GridPane.rowIndex="5"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailLocation" GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true"/>

                        <Label text="Reporter:"     GridPane.rowIndex="6"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailReporter" GridPane.rowIndex="6" GridPane.columnIndex="1" wrapText="true"/>

                        <Label text="Phone:"        GridPane.rowIndex="7"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailPhone"  GridPane.rowIndex="7"  GridPane.columnIndex="1"/>

                        <Label text="Submitted:"    GridPane.rowIndex="8"  GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="detailTimestamp" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <columnConstraints>
                            <ColumnConstraints minWidth="80.0"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/>
                        </columnConstraints>
                    </GridPane>

                    <Separator fx:id="detailDescSep" visible="false" managed="false"/>
                    <Label fx:id="detailDescHeading" text="Description:" visible="false" managed="false"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="descriptionLabel" text="" wrapText="true"
                           style="-fx-text-fill: #333333;"/>

                    <!-- Response section (shown only when a response record exists) -->
                    <Separator fx:id="detailRespSep" visible="false" managed="false"/>
                    <Label fx:id="detailRespHeading" text="Response Information:"
                           visible="false" managed="false"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #16a085;"/>

                    <Label fx:id="detailRespNoResponse" text="No response assigned yet."
                           visible="false" managed="false"
                           wrapText="true"
                           style="-fx-text-fill: #95a5a6; -fx-font-style: italic;"/>

                    <Label fx:id="detailDeptHeading" text="Departments:" visible="false" managed="false"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailDepartments" text="" wrapText="true"
                           visible="false" managed="false"
                           style="-fx-text-fill: #333333;"/>

                    <Label fx:id="detailRespPersonHeading" text="Responders:" visible="false" managed="false"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailResponders" text="" wrapText="true"
                           visible="false" managed="false"
                           style="-fx-text-fill: #333333;"/>

                    <Label fx:id="detailNotesHeading" text="Activities / Notes:" visible="false" managed="false"
                           style="-fx-font-weight: bold;"/>
                    <Label fx:id="detailRespNotes" text="" wrapText="true"
                           visible="false" managed="false"
                           style="-fx-text-fill: #333333;"/>

                </VBox>
                </ScrollPane>
            </HBox>

            <padding><Insets top="5.0" bottom="5.0" left="0.0" right="0.0"/></padding>
        </VBox>
    </children>
</AnchorPane>
